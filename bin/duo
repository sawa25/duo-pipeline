#!/usr/bin/env bash
# duo — запуск duo-пайплайна из ЛЮБОГО проекта (источник истины — репозиторий duo-pipeline).
# Корень проекта определяет сам оркестратор (--repo > $DUO_REPO > git-корень cwd).
# Интерпретатор: $DUO_PYTHON > env311 (anaconda/miniconda) > python3.12/3.11/python3 (нужен >= 3.11).
# Машинные настройки (DUO_PYTHON, DUO_GATES_CPUS, …) — в необязательном файле
# ${XDG_CONFIG_HOME:-~/.config}/duo-pipeline/env (формат VAR=значение, вне git): он читается здесь,
# поэтому действует одинаково в интерактивной оболочке, неинтерактивном ssh и systemd-юните.
set -euo pipefail

DUO_ENV_FILE="${DUO_ENV_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/duo-pipeline/env}"
if [[ -f "$DUO_ENV_FILE" ]]; then
    set -a
    # shellcheck disable=SC1090
    . "$DUO_ENV_FILE"
    set +a
fi

# claude (и прочие user-level утилиты) ставятся в ~/.local/bin; в неинтерактивном ssh и в systemd
# user-юните этого каталога в PATH может не быть, а оркестратор зовёт `claude` по имени.
case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) [[ -d "$HOME/.local/bin" ]] && export PATH="$HOME/.local/bin:$PATH" ;;
esac

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"

pick_python() {
    if [[ -n "${DUO_PYTHON:-}" ]]; then
        echo "$DUO_PYTHON"
        return
    fi
    local c
    for c in "$HOME/anaconda3/envs/env311/bin/python" "$HOME/miniconda3/envs/env311/bin/python"; do
        if [[ -x "$c" ]]; then
            echo "$c"
            return
        fi
    done
    for c in python3.12 python3.11 python3; do
        if command -v "$c" >/dev/null 2>&1 \
            && "$c" -c 'import sys; sys.exit(sys.version_info < (3, 11))'; then
            command -v "$c"
            return
        fi
    done
    echo "duo: нужен Python >= 3.11 (задай DUO_PYTHON=/путь/к/python)" >&2
    exit 127
}

# Выбранный интерпретатор экспортируется: его видят исполнитель и ревьюеры (дочерний claude)
# и шаги гейтов — подсказки в проектном конфиге могут ссылаться на $DUO_PYTHON, а не на путь машины.
DUO_PYTHON="$(pick_python)"
export DUO_PYTHON
exec "$DUO_PYTHON" "$ROOT/duo_pipeline.py" "$@"
