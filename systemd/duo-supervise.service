[Unit]
Description=duo-pipeline supervise: надзор за сериями (dead/halted -> алерт и авто-возобновление, done/impl_pending -> уведомление)

[Service]
Type=oneshot
# КРИТИЧНО: без KillMode=process systemd по завершении oneshot-сервиса убивает ВСЮ cgroup,
# включая оркестратор, который supervise только что запустил detached (так умирал старый
# duo-watchdog-failsafe: «перезапуск удался» в логе, а процесса через секунду уже не было).
KillMode=process
WorkingDirectory=/home/sawa/GitHub/vca-platform
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus
ExecStart=/home/sawa/anaconda3/envs/env311/bin/python /home/sawa/GitHub/vca-platform/tools/dev/duo_pipeline/duo_pipeline.py supervise
