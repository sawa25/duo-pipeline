# --- кэши Python и инструментов -------------------------------------------------
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- окружения и упаковка (на случай venv/сборки рядом с кодом) ------------------
.venv/
venv/
*.egg-info/
build/
dist/

# --- рантайм серий самого инструмента (dogfooding) ---------------------------------
# артефакты серий (pipeline/<task>/) не публикуются: это данные серий (транскрипты, логи,
# патчи), а не код инструмента. `/pipeline/` покрывает и lock-файлы; строку `pipeline/*/.lock`
# держим, потому что именно её `duo setup` дописывает проектам — единый вид у всех.
/pipeline/
pipeline/*/.lock

# git-worktree параллельных серий (git.worktrees_dir из config.json)
/.worktrees/

# --- секреты: токены, ключи, локальные .env — НИКОГДА в публичный репозиторий -------
# (имя `*token*` целиком не игнорируем: спрятало бы обычный код вроде tokenizer.py)
githubtoken.md
*.token
.env
.env.*
!.env.example
*.pem
*.key
*.p12
id_rsa*
id_ed25519*

# --- локальные настройки агентов и редакторов -------------------------------------
.claude/settings.local.json
.idea/
.vscode/
*.swp
*~
.DS_Store
